{
  "name": "avianvisitors",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "vite frontend",
    "build": "vue-tsc -b frontend && vite build frontend",
    "preview": "vite preview frontend",
    "typecheck": "vue-tsc -b frontend --noEmit",
    "lint": "oxlint frontend/src",
    "format": "oxfmt frontend/src/styles.css",
    "format:check": "oxfmt --check frontend/src/styles.css",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
